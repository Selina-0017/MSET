          }
        }
      ]
    },
    {
      "binary": "varlen_metadata_pattern",
      "cases": [
        {
          "name": "safe_varlen_metadata_read",
          "bugClass": "none",
          "memorySpace": "global",
          "expectedSignal": "none",
          "reproducer": "./varlen_metadata_pattern safe_varlen_metadata_read",
          "source": {
            "kind": "github",
            "description": "Safe control for FlashAttention varlen metadata where cu_seqlens matches the actual q token count.",
            "url": "https://github.com/Dao-AILab/flash-attention/issues/2381"
          }
        },
        {
          "name": "varlen_cu_seqlens_mismatch_read",
          "bugClass": "oobRead",
          "memorySpace": "global",
          "expectedSignal": "oobRead",
          "reproducer": "./varlen_metadata_pattern varlen_cu_seqlens_mismatch_read",
          "source": {
            "kind": "github",
